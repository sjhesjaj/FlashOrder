<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flashorder.request.guard.CampaignProtectionMapper">
    <resultMap id="campaignState" type="com.flashorder.request.guard.CampaignProtectionMapper$CampaignState">
        <constructor>
            <arg column="campaign_id" javaType="_long"/>
            <arg column="starts_at" javaType="java.time.LocalDateTime"/>
            <arg column="ends_at" javaType="java.time.LocalDateTime"/>
            <arg column="available" javaType="java.lang.Integer"/>
            <arg column="database_time" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <resultMap id="acceptedCount" type="com.flashorder.request.guard.CampaignProtectionMapper$AcceptedCount">
        <constructor>
            <arg column="campaign_id" javaType="_long"/>
            <arg column="accepted" javaType="_long"/>
        </constructor>
    </resultMap>

    <select id="readCampaigns" resultMap="campaignState">
        SELECT c.id AS campaign_id, c.starts_at, c.ends_at, i.available, NOW(6) AS database_time
        FROM campaign c
        LEFT JOIN inventory i
          ON i.campaign_id = c.id AND c.starts_at &lt;= NOW(6) AND NOW(6) &lt; c.ends_at
    </select>

    <select id="readAcceptedCounts" resultMap="acceptedCount">
        SELECT campaign_id, COUNT(*) AS accepted
        FROM purchase_request
        WHERE status = 'ACCEPTED'
        GROUP BY campaign_id
    </select>

    <select id="countAccepted" resultType="_long">
        SELECT COUNT(*)
        FROM purchase_request
        WHERE campaign_id = #{campaignId} AND status = 'ACCEPTED'
    </select>
</mapper>
